<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.TodoController">

    <!-- Top: MenuBar -->
    <top>
        <MenuBar>
            <Menu text="File">
                <MenuItem onAction="#handleExit" text="Exit" />
            </Menu>
            <Menu text="Edit">
                <MenuItem onAction="#handleClearFilters" text="Clear All Filters" />
            </Menu>
            <Menu text="Help">
                <MenuItem onAction="#handleAbout" text="About" />
            </Menu>
        </MenuBar>
    </top>

    <center>
        <SplitPane dividerPositions="0.2, 0.7">
            <!-- Left: Navigation Sidebar -->
            <VBox minWidth="200" styleClass="sidebar">
                <Label styleClass="sidebar-label" text="SMART LISTS" />
                <Button maxWidth="Infinity" onAction="#filterAll" styleClass="nav-button" text="All Tasks" />
                <Button maxWidth="Infinity" onAction="#filterToday" styleClass="nav-button" text="Today" />
                <Button maxWidth="Infinity" onAction="#filterImportant" styleClass="nav-button" text="Important" />
                <Button maxWidth="Infinity" onAction="#filterCompleted" styleClass="nav-button" text="Completed" />

                <Region prefHeight="10" />
                <Label styleClass="sidebar-label" text="FILTER BY DATE" />
                <DatePicker fx:id="sidebarDatePicker" maxWidth="Infinity" promptText="Select Date" />

                <Region prefHeight="20" />
                
                <Label styleClass="sidebar-label" text="CATEGORIES" />
                <VBox fx:id="categoryListVBox" spacing="5" />
            </VBox>

            <!-- Center: Task List -->
            <VBox minWidth="400" styleClass="task-list-pane">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="header-label" text="Tasks" />
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="searchField" prefWidth="200" promptText="Search" styleClass="search-field" />
                </HBox>

                <TableView fx:id="taskTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="completedColumn" prefWidth="40" resizable="false" />
                        <TableColumn fx:id="titleColumn" prefWidth="300" text="Title" />
                        <TableColumn fx:id="dueDateColumn" prefWidth="100" text="Date" />
                        <TableColumn fx:id="priorityColumn" prefWidth="80" text="Priority" />
                        <TableColumn fx:id="categoryColumn" prefWidth="100" text="Category" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Right: Inspector / Details -->
            <VBox minWidth="300" spacing="10" styleClass="details-pane">
                <Label styleClass="details-header" text="Details" />
                
                <Label styleClass="form-label" text="Title" />
                <TextField fx:id="titleField" promptText="Task Title" />

                <Label styleClass="form-label" text="Description" />
                <TextArea fx:id="descriptionArea" prefRowCount="3" promptText="Add a note..." wrapText="true" />

                <Label styleClass="form-label" text="Due Date" />
                <DatePicker fx:id="dueDatePicker" maxWidth="Infinity" />

                <Label styleClass="form-label" text="Category" />
                <ComboBox fx:id="categoryComboBox" editable="true" maxWidth="Infinity" promptText="Select or Type..." />

                <Label styleClass="form-label" text="Priority" />
                <ComboBox fx:id="priorityComboBox" maxWidth="Infinity" promptText="None" />

                <Region prefHeight="20" VBox.vgrow="ALWAYS" />

                <Button fx:id="addButton" maxWidth="Infinity" onAction="#handleAddTask" styleClass="action-button" text="Add Task" />
                <Button fx:id="editButton" maxWidth="Infinity" onAction="#handleEditTask" styleClass="action-button" text="Update Task" visible="false" managed="false" />
                
                <Button fx:id="deleteButton" maxWidth="Infinity" onAction="#handleDeleteTask" styleClass="delete-button" text="Delete Task" />
            </VBox>
        </SplitPane>
    </center>

</BorderPane>
