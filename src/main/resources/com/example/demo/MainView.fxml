<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import com.example.demo.model.Category?>
<?import com.example.demo.model.Priority?>

<BorderPane fx:controller="com.example.demo.TodoController"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="1200" prefHeight="700">

    <!-- MENU BAR -->
    <top>
        <MenuBar>
            <Menu text="File">
                <items>
                    <MenuItem text="Save" onAction="#saveTasks" />
                    <MenuItem text="Exit" onAction="#handleExit" />
                </items>
            </Menu>
            <Menu text="Help">
                <items>
                    <MenuItem text="About" onAction="#showAbout" />
                </items>
            </Menu>
        </MenuBar>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <GridPane hgap="15" vgap="12" alignment="CENTER">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <!-- LEFT: INPUT FORM -->
            <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="10">
                <Label text="Add / Edit Task" style="-fx-font-size:18; -fx-font-weight:bold;"/>
                <TextField fx:id="titleField" promptText="Title"/>
                <TextArea fx:id="descriptionArea" promptText="Description" prefHeight="100"/>
                <DatePicker fx:id="dueDatePicker" promptText="Due Date"/>

                <!-- CATEGORY -->
                <ComboBox fx:id="categoryComboBox" promptText="Category" />

                <!-- PRIORITY -->
                <ComboBox fx:id="priorityComboBox" promptText="Priority" />

                <HBox spacing="8">
                    <Button text="Add" onAction="#addTask"/>
                    <Button text="Edit" onAction="#editTask"/>
                    <Button text="Delete" onAction="#deleteTask"/>
                    <Button text="Complete" onAction="#markCompleted"/>
                </HBox>

                <TextField fx:id="searchField" promptText="Search…" onKeyReleased="#onSearch"/>
            </VBox>

            <!-- RIGHT: TASK TABLE -->
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="10">
                <Label text="Your Tasks" style="-fx-font-size:18; -fx-font-weight:bold;"/>
                <TableView fx:id="taskTable" prefWidth="720" prefHeight="520">
                    <columns>
                        <TableColumn fx:id="titleColumn"       text="Title"       prefWidth="160"/>
                        <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="220"/>
                        <TableColumn fx:id="dueDateColumn"     text="Due Date"    prefWidth="110"/>
                        <TableColumn fx:id="categoryColumn"    text="Category"    prefWidth="100"/>
                        <TableColumn fx:id="priorityColumn"    text="Priority"    prefWidth="90"/>
                        <TableColumn fx:id="completedColumn"   text="Done"        prefWidth="70"/>
                    </columns>
                </TableView>
            </VBox>
        </GridPane>
    </center>

    <!-- STATUS BAR -->
    <bottom>
        <Label fx:id="statsLabel" text="Completed: 0 / Total: 0"
               style="-fx-padding:10; -fx-font-size:14;"/>
    </bottom>
</BorderPane>